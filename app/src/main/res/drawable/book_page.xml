<?xml version="1.0" encoding="utf-8"?>
<!-- 书页纸张：暖白渐变 + 右/左浅色阴影，模拟纸张质感 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="#FBF6E8"
                android:centerColor="#F5EEDC"
                android:endColor="#EFE5CC"
                android:angle="90"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#D8CBA6" />
        </shape>
    </item>
</layer-list>
