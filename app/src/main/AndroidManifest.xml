<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 联网权限：仅用于检查更新与下载新版 APK -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 8+ 从应用内安装更新 APK 需要 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 本应用为纯离线应用，不请求任何危险权限；朗读依赖系统 TTS 服务（系统组件，无需声明权限） -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Poetry"
        tools:targetApi="26">
        <!-- FileProvider：用于把下载好的更新 APK 提供给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 启动动画页（启动入口）：书翻开 + 两扇门打开 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Poetry.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 首次启动介绍/同意页 -->
        <activity
            android:name=".IntroActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MineActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".FavActivity"
            android:exported="false"
            android:parentActivityName=".MineActivity" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:parentActivityName=".MineActivity" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MineActivity" />

    </application>
</manifest>